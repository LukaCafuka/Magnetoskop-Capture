<Window x:Class="Magnetoskop.App.Views.ConnectionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Magnetoskop.App.ViewModels"
        xmlns:views="clr-namespace:Magnetoskop.App.Views"
        Title="Connections"
        Width="440" Height="620"
        MinWidth="380" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d">
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CloseConnectionsWindowCommand}"/>
    </Window.InputBindings>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#DDDDDD"/>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="MinWidth" Value="70"/>
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#999999"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
        <StackPanel>
            <!-- VTR / recorder -->
            <Border Background="#262626" Padding="12" Margin="0,0,0,12" CornerRadius="4">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Content="⟳" MinWidth="34" Margin="0"
                                ToolTip="Refresh COM ports"
                                Command="{Binding RefreshVtrConnectionsCommand}"/>
                        <TextBlock Text="RECORDER" FontWeight="Bold" VerticalAlignment="Center"/>
                    </DockPanel>

                    <TextBlock Text="Connection" Style="{StaticResource FieldLabel}"/>
                    <ComboBox ItemsSource="{Binding VtrConnections}"
                              SelectedItem="{Binding SelectedVtrConnection}"/>

                    <TextBlock Text="Device model" Style="{StaticResource FieldLabel}"/>
                    <ComboBox ItemsSource="{Binding VtrProfiles}"
                              SelectedItem="{Binding SelectedVtrProfile}"
                              DisplayMemberPath="DisplayName"/>
                    <TextBlock Foreground="#999999" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="Connects automatically when a COM port is selected. Default model is Generic Sony 9-pin."/>

                    <TextBlock Text="{Binding DeviceDescription}" Margin="0,0,0,2"/>
                    <TextBlock Text="{Binding DetectedProfileText}" Foreground="#88BBFF"
                               FontSize="11" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Capture devices -->
            <Border Background="#262626" Padding="12" Margin="0,0,0,0" CornerRadius="4"
                    IsEnabled="{Binding CanConfigureCapture}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Content="Refresh" Margin="0"
                                Command="{Binding RefreshDevicesCommand}"/>
                        <TextBlock Text="CAPTURE DEVICES" FontWeight="Bold" VerticalAlignment="Center"/>
                    </DockPanel>

                    <TextBlock Text="Video device" Style="{StaticResource FieldLabel}"/>
                    <ComboBox ItemsSource="{Binding VideoDevices}"
                              SelectedItem="{Binding SelectedVideoDevice}"
                              DisplayMemberPath="Name"/>

                    <TextBlock Text="Input standard" Style="{StaticResource FieldLabel}"/>
                    <ComboBox ItemsSource="{Binding VideoStandardOptions}"
                              DisplayMemberPath="DisplayName"
                              SelectedValuePath="Value"
                              SelectedValue="{Binding SelectedVideoInputStandard}"/>

                    <TextBlock Text="Scan mode / field order" Style="{StaticResource FieldLabel}"/>
                    <ComboBox ItemsSource="{Binding VideoScanModeOptions}"
                              DisplayMemberPath="DisplayName"
                              SelectedValuePath="Value"
                              SelectedValue="{Binding SelectedVideoScanMode}"/>

                    <Grid Margin="0,0,0,8"
                          Visibility="{Binding IsCustomVideoInputStandard, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,4,0">
                            <TextBlock Text="Width" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding CustomVideoWidth, UpdateSourceTrigger=LostFocus}" Padding="4,2"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="4,0">
                            <TextBlock Text="Height" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding CustomVideoHeight, UpdateSourceTrigger=LostFocus}" Padding="4,2"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="4,0,0,0">
                            <TextBlock Text="Frame rate" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding CustomVideoFrameRate, UpdateSourceTrigger=LostFocus}" Padding="4,2"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding VideoInputConfigurationStatusText}"
                               Foreground="#FFD166" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,3"/>
                    <TextBlock Text="{Binding VideoInputFormatStatusText}"
                               Foreground="#FFD166" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4"/>
                    <CheckBox IsChecked="{Binding IsVideoFormatMismatchAcknowledged}"
                              Visibility="{Binding IsVideoFormatAcknowledgmentRequired, Converter={StaticResource BoolToVis}}"
                              Content="I verified this exact requested/driver format"
                              Foreground="#DDDDDD" Margin="0,0,0,10"
                              ToolTip="Stored only for this device and exact requested/actual format pair. A changed format requires a new acknowledgment."/>

                    <TextBlock Text="Audio device (auto-selected unless changed)"
                               Style="{StaticResource FieldLabel}"/>
                    <ComboBox ItemsSource="{Binding AudioDevices}"
                              SelectedItem="{Binding SelectedAudioDevice}"
                              DisplayMemberPath="Name"
                              SelectionChanged="AudioDevice_SelectionChanged"/>

                    <TextBlock Text="Static A/V calibration — audio offset (ms)"
                               Style="{StaticResource FieldLabel}"/>
                    <DockPanel Margin="0,0,0,4">
                        <CheckBox DockPanel.Dock="Right"
                                  IsChecked="{Binding IsAvCalibrationCalibrated}"
                                  Content="Measured"
                                  Foreground="#DDDDDD" Margin="10,0,0,0"
                                  VerticalAlignment="Center"/>
                        <TextBox Text="{Binding AudioCalibrationOffsetMilliseconds, UpdateSourceTrigger=LostFocus}"
                                 Padding="4,2"
                                 ToolTip="Positive values delay audio. Unmeasured values are stored but are not applied."/>
                    </DockPanel>
                    <TextBlock Text="{Binding AvCalibrationStatusText}"
                               Foreground="#FFD166" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"/>

                    <CheckBox IsChecked="{Binding AudioMonitoringEnabled}"
                              Foreground="#DDDDDD" Margin="0,0,0,8"
                              Content="Monitor audio"
                              ToolTip="Play the selected audio input through the default speakers/headphones"/>

                    <DockPanel Margin="0,0,0,8">
                        <TextBlock DockPanel.Dock="Left" Text="Volume"
                                   VerticalAlignment="Center" Margin="0,0,8,0"
                                   Foreground="#AAAAAA"/>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding MonitorVolumeLabel}"
                                   VerticalAlignment="Center" MinWidth="40" TextAlignment="Right"
                                   FontFamily="Consolas" Foreground="#66FF99" Margin="8,0,0,0"/>
                        <Slider Minimum="0" Maximum="200" TickFrequency="10"
                                IsSnapToTickEnabled="False"
                                Value="{Binding MonitorVolumePercent, UpdateSourceTrigger=PropertyChanged}"
                                VerticalAlignment="Center"
                                ToolTip="Monitor playback volume (0–200%). Does not affect recording levels."/>
                    </DockPanel>

                    <TextBlock Text="Audio levels" Style="{StaticResource FieldLabel}"/>
                    <views:AudioMetersControl Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Window>
