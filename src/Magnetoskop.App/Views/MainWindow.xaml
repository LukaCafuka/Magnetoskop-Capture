<Window x:Class="Magnetoskop.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Magnetoskop.App.ViewModels"
        Title="Magnetoskop Capture"
        Width="1280" Height="900"
        MinWidth="1100" MinHeight="780"
        Background="#1E1E1E"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d">
    <Window.InputBindings>
        <KeyBinding Key="MediaPlayPause" Command="{Binding MediaPlayPauseCommand}"/>
        <KeyBinding Key="MediaStop" Command="{Binding MediaStopCommand}"/>
        <KeyBinding Key="MediaNextTrack" Command="{Binding MediaFastForwardCommand}"/>
        <KeyBinding Key="MediaPreviousTrack" Command="{Binding MediaRewindCommand}"/>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding ToggleStandbyCommand}"/>
    </Window.InputBindings>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#DDDDDD"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="MinWidth" Value="70"/>
        </Style>
        <Style x:Key="TransportStopButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#0A3D6E"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#145A9E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#145A9E"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#072A4D"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Yellow when status-sense Standby is on; gray when off (follows deck, including auto Stby Off). -->
        <Style x:Key="StandbyToggleButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#D0D0D0"/>
            <Setter Property="Foreground" Value="#1A1A1A"/>
            <Setter Property="BorderBrush" Value="#A8A8A8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsStandbyOn}" Value="True">
                    <Setter Property="Background" Value="#C9A227"/>
                    <Setter Property="Foreground" Value="#1A1A1A"/>
                    <Setter Property="BorderBrush" Value="#A8841A"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TimecodeText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="Foreground" Value="#66FF99"/>
        </Style>
        <Style x:Key="TimecodeLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#999999"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>
        <Style TargetType="Menu">
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="Foreground" Value="#DDDDDD"/>
            <Setter Property="Padding" Value="4,2"/>
        </Style>
        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="#DDDDDD"/>
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>
        <!-- ComboBoxes use a light system background; override the window TextBlock
             foreground so selected/dropdown text stays readable (black on white). -->
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#1A1A1A"/>
            <Style.Resources>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="#1A1A1A"/>
                </Style>
            </Style.Resources>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#1A1A1A"/>
            <Style.Resources>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="#1A1A1A"/>
                </Style>
            </Style.Resources>
        </Style>
        <Style TargetType="ToggleButton">
            <Setter Property="Foreground" Value="#1A1A1A"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="MinWidth" Value="56"/>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Foreground" Value="#66FF99"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="Choose save location…"
                          Command="{Binding BrowseOutputDirectoryCommand}"/>
                <Separator/>
                <MenuItem Header="Settings…"
                          Command="{Binding OpenSettingsCommand}"/>
            </MenuItem>
            <MenuItem Header="_Video">
                <MenuItem Header="Video settings…"
                          Command="{Binding OpenVideoSettingsCommand}"/>
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="Watch window…"
                          Command="{Binding OpenWatchWindowCommand}"/>
            </MenuItem>
            <MenuItem Header="_Audio">
                <MenuItem Header="Coming soon" IsEnabled="False"/>
            </MenuItem>
        </Menu>

        <StatusBar DockPanel.Dock="Bottom" Background="#252525" Foreground="#CCCCCC"
                   Padding="10,4" BorderBrush="#3A3A3A" BorderThickness="0,1,0,0">
            <StatusBar.Resources>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="#CCCCCC"/>
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <Setter Property="FontSize" Value="12"/>
                </Style>
                <Style TargetType="Separator">
                    <Setter Property="Background" Value="#555555"/>
                    <Setter Property="Margin" Value="10,2"/>
                    <Setter Property="Width" Value="1"/>
                </Style>
            </StatusBar.Resources>
            <StatusBarItem>
                <TextBlock FontWeight="SemiBold" MinWidth="72"
                           Text="{Binding StatusBarRecordingText}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#CCCCCC"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                    <Setter Property="Foreground" Value="#FF5555"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Elapsed  " Foreground="#888888"/>
                    <TextBlock Text="{Binding StatusBarElapsedText}" FontFamily="Consolas" MinWidth="64"/>
                </StackPanel>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Codec  " Foreground="#888888"/>
                    <TextBlock Text="{Binding StatusBarCodecText}" TextTrimming="CharacterEllipsis" MaxWidth="360"/>
                </StackPanel>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="VTR  " Foreground="#888888"/>
                    <TextBlock Text="{Binding StatusBarTransportText}" FontWeight="SemiBold" Foreground="#FFCC66"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="*" MinWidth="340"/>
        </Grid.ColumnDefinitions>

        <!-- Left: preview + transport + error + log -->
        <Grid Grid.Column="0" Margin="0,0,10,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Preview -->
            <Border Grid.Row="0" Background="Black" Margin="0,0,0,10">
                <Grid>
                    <Image Source="{Binding PreviewSource}" Stretch="Uniform"/>
                    <TextBlock Text="No preview"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="#555555" FontSize="20">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPreviewRunning}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

            <!-- Transport bar (VTR layout: REW · PLAY · FF + Jog/Shuttle wheel) -->
            <Border Grid.Row="1"
                    Background="#262626" Padding="10" Margin="0,0,0,10" CornerRadius="4">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Content="⏪ Rew" Command="{Binding RewindCommand}"
                            VerticalAlignment="Top" MinWidth="80" Height="36" Margin="4,0"/>
                    <Grid Margin="4,0" VerticalAlignment="Top">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Row="0" Grid.Column="0" Content="▶ Play" Command="{Binding PlayCommand}"
                                FontWeight="Bold" Width="80" Height="36" Margin="0,0,4,4"/>
                        <Button Grid.Row="0" Grid.Column="1" Content="⏩ FF" Command="{Binding FastForwardCommand}"
                                Width="80" Height="36" Margin="0,0,0,4"/>
                        <Button Grid.Row="1" Grid.Column="0" Content="■ Stop" Command="{Binding StopCommand}"
                                Style="{StaticResource TransportStopButton}"
                                Width="80" Height="36" Margin="0,0,4,0"/>
                        <Button Grid.Row="1" Grid.Column="1" Content="⏸ Pause" Command="{Binding PauseCommand}"
                                Width="80" Height="36"
                                ToolTip="Still/pause (Shuttle 0) without Stop"/>
                    </Grid>
                    <Button Content="⏏ Eject" Command="{Binding EjectCommand}"
                            VerticalAlignment="Top" MinWidth="80" Height="36" Margin="16,0,0,0"/>
                    <Button Content="Standby" Command="{Binding ToggleStandbyCommand}"
                            Style="{StaticResource StandbyToggleButton}"
                            VerticalAlignment="Top" MinWidth="90" Height="36" Margin="16,0,0,0"
                            ToolTip="Toggle standby (yellow = on / threaded). Follows deck status, including auto standby-off."/>

                    <!-- Jog / Shuttle wheel -->
                    <Border Margin="24,0,0,0" Padding="10,6" Background="#1E1E1E" CornerRadius="4"
                            VerticalAlignment="Top" MinWidth="220"
                            IsEnabled="{Binding CanUseTransportButtons}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,4">
                                <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center"
                                           FontFamily="Consolas" FontSize="12" Foreground="#66FF99"
                                           Text="{Binding WheelSpeedLabel}" MinWidth="56" TextAlignment="Right"/>
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Content="Jog" Margin="0,0,8,0" Padding="4,2"
                                                 GroupName="JogShuttleMode"
                                                 IsChecked="{Binding IsJogMode, Mode=TwoWay}"
                                                 Foreground="#DDDDDD"
                                                 ToolTip="Fine positioning (up to ~1× play)"/>
                                    <RadioButton Content="Shuttle" Padding="4,2"
                                                 GroupName="JogShuttleMode"
                                                 IsChecked="{Binding IsShuttleMode, Mode=TwoWay}"
                                                 Foreground="#DDDDDD"
                                                 ToolTip="Variable search (up to ~50× play)"/>
                                </StackPanel>
                            </DockPanel>
                            <Slider Minimum="-1" Maximum="1" TickFrequency="0.25"
                                    IsSnapToTickEnabled="False"
                                    Value="{Binding WheelPosition, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    IsMoveToPointEnabled="True"
                                    PreviewMouseLeftButtonUp="JogShuttleWheel_Released"
                                    LostMouseCapture="JogShuttleWheel_Released"
                                    ToolTip="Hold and drag: left = reverse, right = forward. Release returns to still and stops."/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Error bar -->
            <Border Grid.Row="2"
                    Background="#5A1E1E" Padding="10,6" Margin="0,0,0,10" CornerRadius="4">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding LastError}" Value="">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="✕" MinWidth="28" Padding="4,0"
                            ToolTip="Dismiss" Command="{Binding DismissErrorCommand}"/>
                    <TextBlock Text="{Binding LastError}" Foreground="#FFB3B3"
                               FontWeight="SemiBold" TextWrapping="Wrap"
                               VerticalAlignment="Center"/>
                </DockPanel>
            </Border>

            <!-- Log (hidden by default; File → Settings…) -->
            <Border Grid.Row="3"
                    Background="#262626" Padding="10" CornerRadius="4" MaxHeight="140"
                    Visibility="{Binding ShowLogPanel, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="LOG" FontWeight="Bold" Margin="0,0,0,4"/>
                    <ListBox ItemsSource="{Binding LogEntries}"
                             Background="Transparent" BorderThickness="0"
                             Foreground="#AAAAAA" FontFamily="Consolas" FontSize="11"/>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Right panel uses full window height (not just the preview row). -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <!-- Time information -->
                <Border Background="#262626" Padding="10" Margin="0,0,0,10" CornerRadius="4">
                    <StackPanel>
                        <TextBlock Text="TIME INFORMATION" FontWeight="Bold" Margin="0,0,0,8"/>
                        <UniformGrid Columns="2">
                            <StackPanel Margin="0,0,10,8">
                                <TextBlock Style="{StaticResource TimecodeLabel}" Text="CTL"/>
                                <TextBlock Style="{StaticResource TimecodeText}" Text="{Binding CtlText}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,0,8">
                                <TextBlock Style="{StaticResource TimecodeLabel}" Text="LTC"/>
                                <Grid>
                                    <TextBlock Text="{Binding LtcText}"
                                               Cursor="Hand"
                                               ToolTip="Click to go to LTC. Enter HH:MM:SS:FF (00:01:00:00 = 1 min) or MM:SS:FF. Esc cancels."
                                               MouseLeftButtonDown="LtcDisplay_MouseLeftButtonDown">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource TimecodeText}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEditingLtc}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBox x:Name="LtcEditBox"
                                             Text="{Binding LtcEditText, UpdateSourceTrigger=PropertyChanged}"
                                             FontFamily="Consolas" FontSize="26"
                                             Foreground="#66FF99" Background="#1A1A1A"
                                             BorderBrush="#66FF99" CaretBrush="#66FF99"
                                             Padding="2,0"
                                             KeyDown="LtcEditBox_KeyDown"
                                             LostKeyboardFocus="LtcEditBox_LostKeyboardFocus">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEditingLtc}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                </Grid>
                            </StackPanel>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Style="{StaticResource TimecodeLabel}" Text="VITC"/>
                                <TextBlock Style="{StaticResource TimecodeText}" Text="{Binding VitcText}"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Style="{StaticResource TimecodeLabel}" Text="USER BITS"/>
                                <TextBlock Style="{StaticResource TimecodeText}" FontSize="20"
                                           Text="{Binding UserBitsText}"/>
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- VTR connection -->
                <Border Background="#262626" Padding="10" Margin="0,0,0,10" CornerRadius="4">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right" Content="⟳" MinWidth="34"
                                    ToolTip="Refresh COM ports"
                                    Command="{Binding RefreshVtrConnectionsCommand}"/>
                            <TextBlock Text="RECORDER CONNECTION" FontWeight="Bold" VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBlock Text="Connection" Style="{StaticResource TimecodeLabel}"/>
                        <ComboBox ItemsSource="{Binding VtrConnections}"
                                  SelectedItem="{Binding SelectedVtrConnection}"
                                  Margin="0,0,0,8"/>
                        <TextBlock Foreground="#999999" FontSize="11" TextWrapping="Wrap"
                                   Text="Connects automatically when selected. Deck model: File → Settings… (default Generic Sony 9-pin)"/>
                    </StackPanel>
                </Border>

                <!-- Recorder status -->
                <Border Background="#262626" Padding="10" Margin="0,0,0,10" CornerRadius="4">
                    <StackPanel>
                        <TextBlock Text="RECORDER STATUS" FontWeight="Bold" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding DeviceDescription}" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding DetectedProfileText}" Foreground="#88BBFF"
                                   FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4"/>
                        <TextBlock FontSize="20" FontWeight="Bold" Foreground="#FFCC66"
                                   Text="{Binding TransportStateText}" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding StatusFlagsText}" Foreground="#FF8866"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding CapabilitiesText}" Foreground="#999999"
                                   FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Devices -->
                <Border Background="#262626" Padding="10" Margin="0,0,0,10" CornerRadius="4">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right" Content="Refresh"
                                    Command="{Binding RefreshDevicesCommand}"/>
                            <TextBlock Text="CAPTURE DEVICES" FontWeight="Bold" VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBlock Text="Video device" Style="{StaticResource TimecodeLabel}"/>
                        <ComboBox ItemsSource="{Binding VideoDevices}"
                                  SelectedItem="{Binding SelectedVideoDevice}"
                                  DisplayMemberPath="Name" Margin="0,0,0,8"/>
                        <TextBlock Text="Audio device (auto-selected unless changed)"
                                   Style="{StaticResource TimecodeLabel}"/>
                        <ComboBox ItemsSource="{Binding AudioDevices}"
                                  SelectedItem="{Binding SelectedAudioDevice}"
                                  DisplayMemberPath="Name" Margin="0,0,0,8"
                                  SelectionChanged="AudioDevice_SelectionChanged"/>
                        <CheckBox IsChecked="{Binding AudioMonitoringEnabled}"
                                  Foreground="#DDDDDD" Margin="0,0,0,8"
                                  Content="Monitor audio"
                                  ToolTip="Play the selected audio input through the default speakers/headphones"/>
                        <TextBlock Text="Audio levels" Style="{StaticResource TimecodeLabel}"/>
                        <Grid Margin="0,2,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <ProgressBar Grid.Row="0" Height="8" Margin="0,0,0,3"
                                         Minimum="0" Maximum="1"
                                         Value="{Binding AudioLevelLeft, Mode=OneWay}"
                                         Foreground="#66FF99" Background="#111111"/>
                            <ProgressBar Grid.Row="1" Height="8"
                                         Minimum="0" Maximum="1"
                                         Value="{Binding AudioLevelRight, Mode=OneWay}"
                                         Foreground="#66FF99" Background="#111111"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Recording -->
                <Border Background="#262626" Padding="10" Margin="0,0,0,0" CornerRadius="4">
                    <StackPanel>
                        <TextBlock Text="RECORDING" FontWeight="Bold" Margin="0,0,0,8"/>
                        <TextBlock Text="Video settings" Style="{StaticResource TimecodeLabel}"/>
                        <TextBox Text="{Binding VideoSettingsSummary, Mode=OneWay}"
                                 IsReadOnly="True" Margin="0,0,0,8"
                                 ToolTip="Configure via Video → Video settings…"/>
                        <TextBlock Text="Output folder" Style="{StaticResource TimecodeLabel}"/>
                        <TextBox Text="{Binding OutputDirectoryDisplay, Mode=OneWay}"
                                 IsReadOnly="True" Margin="0,0,0,8"
                                 ToolTip="Set via File → Choose save location…"/>
                        <CheckBox IsChecked="{Binding AutoPlayOnRecord}"
                                  Foreground="#DDDDDD" Margin="0,0,0,8">
                            <TextBlock Text="Auto-play deck on record" Foreground="#DDDDDD"/>
                        </CheckBox>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Button Content="● Capture" Foreground="Red" FontWeight="Bold"
                                    Command="{Binding StartRecordingCommand}"/>
                            <Button Content="■ Stop capture" Command="{Binding StopRecordingCommand}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding RecordingStatusText}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
    </DockPanel>
</Window>