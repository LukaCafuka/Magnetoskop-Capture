<Window x:Class="Magnetoskop.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Magnetoskop.App.ViewModels"
        Title="Settings"
        Width="500" Height="560"
        MinWidth="440" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E"
        ResizeMode="NoResize"
        d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#DDDDDD"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#DDDDDD"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Foreground" Value="#1A1A1A"/>
            <Style.Resources>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="#1A1A1A"/>
                </Style>
            </Style.Resources>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#1A1A1A"/>
            <Style.Resources>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="#1A1A1A"/>
                </Style>
            </Style.Resources>
        </Style>
    </Window.Resources>

    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="OK" IsDefault="True" Command="{Binding OkCommand}"/>
            <Button Content="Cancel" IsCancel="True" Command="{Binding CancelCommand}"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="VTR" FontWeight="Bold" Margin="0,0,0,12"/>

                <TextBlock Text="Device model" Foreground="#999999" FontSize="11" Margin="0,0,0,2"/>
                <ComboBox ItemsSource="{Binding VtrProfiles}"
                          SelectedItem="{Binding SelectedVtrProfile}"
                          DisplayMemberPath="DisplayName"/>
                <TextBlock Margin="0,0,0,12" Foreground="#999999" FontSize="11" TextWrapping="Wrap"
                           Text="Default is Generic Sony 9-pin, which works for most decks. Choose a specific model only when that deck needs different poll rates, timeouts, or command support."/>

                <CheckBox IsChecked="{Binding DisableTransportDuringRecording}"
                          Content="Disable transport buttons during recording"/>
                <TextBlock Margin="24,0,0,12" Foreground="#999999" FontSize="11" TextWrapping="Wrap"
                           Text="Prevents accidental Stop, Eject, or other transport commands while a capture is writing."/>

                <CheckBox IsChecked="{Binding Ctl24HourWrap}"
                          Content="CTL 24-hour wrap (below zero)"/>
                <TextBlock Margin="24,0,0,18" Foreground="#999999" FontSize="11" TextWrapping="Wrap"
                           Text="Off (default): CTL below zero shows as −00:00:00:01. On: wrap as 23:59:59:24 like many deck counters."/>

                <TextBlock Text="APPLICATION" FontWeight="Bold" Margin="0,0,0,12"/>

                <CheckBox IsChecked="{Binding PreviewYadif2xEnabled}"
                          Content="Yadif 2× deinterlace preview"/>
                <TextBlock Margin="24,0,0,14" Foreground="#999999" FontSize="11" TextWrapping="Wrap"
                           Text="Preview only — smoother interlaced watching; recording encode is unchanged."/>

                <CheckBox IsChecked="{Binding DebugLoggingEnabled}"
                          Content="Enable debug logging"/>
                <TextBlock Margin="24,0,0,4" Foreground="#999999" FontSize="11" TextWrapping="Wrap"
                           Text="When enabled, this instance writes a debug log file under:"/>
                <TextBlock Margin="24,0,0,4" Foreground="#BBBBBB" FontSize="11" FontFamily="Consolas"
                           Text="{Binding DebugLogFolderHint}" TextWrapping="Wrap"/>
                <TextBlock Margin="24,0,0,14" Foreground="#999999" FontSize="11" TextWrapping="Wrap"
                           Text="Each app instance gets its own file (magnetoskop_debug_…_pid.log)."/>

                <CheckBox IsChecked="{Binding ShowLogPanel}"
                          Content="Show log panel in the main window"/>
                <TextBlock Margin="24,0,0,0" Foreground="#999999" FontSize="11" TextWrapping="Wrap"
                           Text="Displays the scrolling LOG section at the bottom of the main window."/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
