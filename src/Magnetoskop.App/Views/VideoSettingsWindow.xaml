<Window x:Class="Magnetoskop.App.Views.VideoSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Magnetoskop.App.ViewModels"
        Title="Video settings"
        Width="520" Height="640"
        MinWidth="460" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E"
        ResizeMode="CanResizeWithGrip"
        d:DataContext="{d:DesignInstance Type=vm:VideoSettingsViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#DDDDDD"/>
        </Style>
        <Style TargetType="Label" BasedOn="{StaticResource {x:Type Label}}">
            <Setter Property="Foreground" Value="#AAAAAA"/>
            <Setter Property="Padding" Value="0,0,0,2"/>
        </Style>
        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Foreground" Value="#DDDDDD"/>
            <Setter Property="Margin" Value="0,4,0,4"/>
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="4,2"/>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,8,0,8"/>
            <Setter Property="Foreground" Value="#EEEEEE"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="14">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="OK" IsDefault="True" Command="{Binding OkCommand}"/>
            <Button Content="Cancel" IsCancel="True" Command="{Binding CancelCommand}"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionHeader}" Text="OUTPUT"/>
                <Label Content="Container"/>
                <ComboBox ItemsSource="{Binding AvailableContainers}"
                          SelectedItem="{Binding SelectedContainer}"
                          DisplayMemberPath="DisplayName"/>
                <Label Content="Codec"/>
                <ComboBox ItemsSource="{Binding AvailableCodecs}"
                          SelectedItem="{Binding SelectedCodec}"
                          DisplayMemberPath="DisplayName"/>
                <TextBlock Text="{Binding CompatibilityNote}" Foreground="#FFCC66"
                           TextWrapping="Wrap" Margin="0,0,0,8">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#FFCC66"/>
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CompatibilityNote}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <CheckBox Content="Preserve interlacing (off = yadif 2× → 50p for PAL)"
                          IsChecked="{Binding PreserveInterlacing}"/>
                <CheckBox Content="Write faststart (moov at beginning)"
                          IsChecked="{Binding Mp4FastStart}"
                          Visibility="{Binding ShowFastStartOption, Converter={StaticResource BoolToVis}}"/>

                <!-- H.264 / H.265 -->
                <StackPanel Visibility="{Binding ShowAvcHevcOptions, Converter={StaticResource BoolToVis}}">
                    <TextBlock Style="{StaticResource SectionHeader}" Text="ADVANCED — H.264 / H.265"/>
                    <Label Content="CRF (lower = higher quality)"/>
                    <DockPanel Margin="0,0,0,10">
                        <TextBox DockPanel.Dock="Right" Width="48"
                                 Text="{Binding Crf, UpdateSourceTrigger=PropertyChanged}"/>
                        <Slider Minimum="0" Maximum="51" TickFrequency="1" IsSnapToTickEnabled="True"
                                Value="{Binding Crf}"/>
                    </DockPanel>
                    <Label Content="Preset"/>
                    <ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding Preset}"/>
                    <Label Content="Tune"/>
                    <ComboBox ItemsSource="{Binding Tunes}" SelectedItem="{Binding Tune}"/>
                    <Label Content="Profile"/>
                    <ComboBox ItemsSource="{Binding CurrentVideoProfiles}"
                              SelectedItem="{Binding SelectedVideoProfile}"
                              DisplayMemberPath="DisplayName"/>
                    <Label Content="Keyframe interval (GOP)"/>
                    <TextBox Text="{Binding GopSize, UpdateSourceTrigger=PropertyChanged}"/>
                    <Label Content="Pixel format"/>
                    <ComboBox ItemsSource="{Binding PixelFormats}"
                              SelectedItem="{Binding SelectedPixelFormat}"
                              DisplayMemberPath="DisplayName"/>
                </StackPanel>

                <!-- FFV1 -->
                <StackPanel Visibility="{Binding ShowFfv1Options, Converter={StaticResource BoolToVis}}">
                    <TextBlock Style="{StaticResource SectionHeader}" Text="ADVANCED — FFV1"/>
                    <Label Content="Level"/>
                    <ComboBox ItemsSource="{Binding Ffv1Levels}"
                              SelectedItem="{Binding SelectedFfv1Level}"
                              DisplayMemberPath="DisplayName"/>
                    <Label Content="Slices"/>
                    <TextBox Text="{Binding Ffv1Slices, UpdateSourceTrigger=PropertyChanged}"/>
                    <CheckBox Content="Per-slice CRC" IsChecked="{Binding Ffv1SliceCrc}"/>
                    <Label Content="GOP size (1 = intra-only / archival)"/>
                    <TextBox Text="{Binding GopSize, UpdateSourceTrigger=PropertyChanged}"/>
                    <Label Content="Pixel format"/>
                    <ComboBox ItemsSource="{Binding PixelFormats}"
                              SelectedItem="{Binding SelectedPixelFormat}"
                              DisplayMemberPath="DisplayName"/>
                </StackPanel>

                <!-- ProRes -->
                <StackPanel Visibility="{Binding ShowProResOptions, Converter={StaticResource BoolToVis}}">
                    <TextBlock Style="{StaticResource SectionHeader}" Text="ADVANCED — ProRes"/>
                    <Label Content="ProRes profile"/>
                    <ComboBox ItemsSource="{Binding ProResProfiles}"
                              SelectedItem="{Binding SelectedProResProfile}"
                              DisplayMemberPath="DisplayName"/>
                    <Label Content="Pixel format"/>
                    <ComboBox ItemsSource="{Binding PixelFormats}"
                              SelectedItem="{Binding SelectedPixelFormat}"
                              DisplayMemberPath="DisplayName"/>
                </StackPanel>

                <!-- DNxHD / DNxHR -->
                <StackPanel Visibility="{Binding ShowDnxHdOptions, Converter={StaticResource BoolToVis}}">
                    <TextBlock Style="{StaticResource SectionHeader}" Text="ADVANCED — DNxHD"/>
                    <Label Content="DNxHR profile"/>
                    <ComboBox ItemsSource="{Binding DnxHdProfiles}"
                              SelectedItem="{Binding SelectedDnxHdProfile}"
                              DisplayMemberPath="DisplayName"/>
                    <Label Content="Pixel format"/>
                    <ComboBox ItemsSource="{Binding PixelFormats}"
                              SelectedItem="{Binding SelectedPixelFormat}"
                              DisplayMemberPath="DisplayName"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
